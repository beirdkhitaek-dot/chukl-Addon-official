{
  "schemaVersion": 1,
  "id": "chukl-addon",
  "version": "${version}",
  "name": "ChuklAddon",
  "description": "ChuklAddon: a Meteor Client addon with base-finding ESPs (Sus Chunk Finder, Dug Out Highlighter, Deep Block Entity ESP, Light Finder), render and visual modules, and GoodRoad navigation. Open source (GPL-3.0).",
  "authors": [
    "Chukl"
  ],
  "contact": {
    "homepage": "https://github.com/beirdkhitaek-dot/chukl-addon-official",
    "sources": "https://github.com/beirdkhitaek-dot/chukl-addon-official",
    "issues": "https://github.com/beirdkhitaek-dot/chukl-addon-official/issues"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.chukl.addon.ChuklAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "0,200,255"
  },
  "depends": {
    "java": ">=21",
    "minecraft": "${mc_version}",
    "meteor-client": "*"
  },
  "mixins": [
    "chukl-addon.mixins.json"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/chukl-addon/icon.png"
}
